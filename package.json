  "dependencies": {
    "lucide-react": "^0.468.0",
    "next": "16.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.14.0",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "typescript": "7.0.2",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
