{
  "name": "qaci-duo-playbooks",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "QACI Duo Digital Workers and playbooks, contributed by pull request",
  "scripts": {
    "test": "node scripts/validate.mjs && node --test tests/*.test.mjs",
    "build": "node scripts/build.mjs dist",
    "import:qaci-duo": "node scripts/import-from-qaci-duo.mjs",
    "site:dev": "next dev --port 3014",
