{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/vanhaito/qaci-duo-playbooks/main/schema/worker.schema.json",
  "title": "QACI Duo Digital Worker",
  "description": "The content of workers/<id>/worker.yaml (souls come from souls/<key>.md and teamBrief from BRIEF.md, never from this file), as checked by validateWorker() in scripts/lib.mjs. This schema documents that hand-written validator; scripts/lib.mjs remains the source of truth and the authoritative CI gate — this is tooling/editor documentation only. `agents`, `chiefOfStaff`, `rooms`, `routines`, `soul`, `connections`, `skills` and `teamBrief` are an optional extension: a worker with none of them is exactly the single-agent, playbooks-only shape every worker file used before this extension. See FORMAT.md.",
  "type": "object",
  "required": [
    "id", "release", "name", "title", "tagline", "description", "category", "author", "license", "color", "outcomes"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$", "description": "Must equal the folder name: workers/<id>/worker.yaml." },
    "release": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "name": { "type": "string", "minLength": 1, "maxLength": 100 },
    "title": { "type": "string", "minLength": 1, "maxLength": 200 },
    "tagline": { "type": "string", "minLength": 1, "maxLength": 160 },
    "description": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "category": { "type": "string", "minLength": 1, "maxLength": 80 },
    "author": {
      "type": "object",
      "required": ["name"],
      "properties": { "name": { "type": "string", "minLength": 1, "maxLength": 100 } },
      "additionalProperties": true
    },
    "license": { "type": "string", "minLength": 1, "maxLength": 80 },
    "tags": { "type": "array", "maxItems": 30, "items": { "type": "string", "maxLength": 80 } },
    "color": { "enum": ["green", "blue", "red", "orange", "purple", "cyan", "pink", "yellow", "teal", "coral"] },
    "featured": { "type": "boolean" },
    "outcomes": {
      "type": "array", "minItems": 1, "maxItems": 12,
      "items": { "type": "string", "minLength": 1, "maxLength": 240 }
    },
    "setupMinutes": { "type": "integer", "minimum": 1, "maximum": 240 },
    "apps": {
      "type": "array", "maxItems": 30,
      "items": {
        "type": "object",
        "required": ["slug", "label", "reason"],
        "properties": {
          "slug": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$", "maxLength": 64 },
          "label": { "type": "string", "minLength": 1, "maxLength": 100 },
          "reason": { "type": "string", "minLength": 1, "maxLength": 240 },
          "optional": { "type": "boolean" }
        },
        "additionalProperties": true
      }
    },
    "playbooks": {
      "description": "1-30 folder names from skills/, each carried as a lightweight trigger+instructions pair. A worker needs playbooks, skills, or both.",
      "type": "array", "minItems": 1, "maxItems": 30,
      "items": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }
    },
    "skills": {
      "description": "1-30 folder names from skills/, each embedded whole as a real importable skill (package.skills.entries[]) instead of a lightweight playbook. A worker needs playbooks, skills, or both.",
      "type": "array", "minItems": 1, "maxItems": 30,
      "items": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }
    },
    "soul": {
      "description": "This worker's own standing system prompt (the agent identified by id/name/title/description/color above), under 24,000 bytes. Optional.",
      "type": "string", "maxLength": 24000
    },
    "teamBrief": {
      "description": "Shared instructions for the whole team, under 24,000 bytes. Becomes the generated package's team.brief.",
      "type": "string", "maxLength": 24000
    },
    "examples": {
      "description": "Up to 12 suggested questions, shown on the worker's page.",
      "type": "array", "maxItems": 12,
      "items": {
        "type": "object",
        "required": ["title", "input", "output"],
        "properties": {
          "title": { "type": "string", "minLength": 1, "maxLength": 120 },
          "input": { "type": "string", "minLength": 1, "maxLength": 4000, "description": "A realistic request a user would make." },
          "output": { "type": "string", "minLength": 1, "maxLength": 8000, "description": "An outline of the response, not a full transcript." }
        },
        "additionalProperties": false
      }
    },
    "connections": {
      "description": "Up to 20 declared MCP slots a specific agent may be given (see agents[].connections). Never carries a secret value.",
      "type": "array", "maxItems": 20,
      "items": {
        "type": "object",
        "required": ["key", "label", "reason", "mcp"],
        "properties": {
          "key": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$", "maxLength": 64 },
          "label": { "type": "string", "minLength": 1, "maxLength": 100 },
          "reason": { "type": "string", "minLength": 1, "maxLength": 240 },
          "mcp": {
            "type": "object",
            "required": ["transport", "url", "valueNames"],
            "properties": {
              "transport": { "enum": ["http", "sse"] },
              "url": { "type": "string", "pattern": "^https://\\S+$", "description": "No embedded credentials (no `user:pass@`)." },
              "valueNames": { "type": "array", "maxItems": 32, "items": { "type": "string" }, "uniqueItems": true, "description": "Header value names the installer will supply; never the values themselves." }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "agents": {
      "description": "Optional extension: teammates in addition to the worker itself (which is always agent `id`). At most 49, for 50 agents total.",
      "type": "array", "maxItems": 49,
      "items": {
        "type": "object",
        "required": ["key", "name", "title", "description", "color"],
        "properties": {
          "key": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$", "maxLength": 64, "description": "Must differ from this worker's own id and from every other agent's key." },
          "name": { "type": "string", "minLength": 1, "maxLength": 100 },
          "title": { "type": "string", "maxLength": 200 },
          "description": { "type": "string", "maxLength": 4000 },
          "color": { "enum": ["green", "blue", "red", "orange", "purple", "cyan", "pink", "yellow", "teal", "coral"] },
          "soul": { "type": "string", "maxLength": 24000, "description": "This agent's own standing system prompt, under 24,000 bytes." },
          "playbooks": {
            "description": "Subset of this worker's own `playbooks` that this agent uses. Defaults to all of them when omitted.",
            "type": "array", "maxItems": 30, "items": { "type": "string" }
          },
          "skills": {
            "description": "Subset of this worker's own `skills` that this agent uses. Defaults to all of them when omitted.",
            "type": "array", "maxItems": 30, "items": { "type": "string" }
          },
          "connections": {
            "description": "Subset of this worker's own `connections` keys this agent is given. Defaults to NONE when omitted — unlike playbooks/skills, a connection is never handed out unless explicitly listed.",
            "type": "array", "maxItems": 20, "items": { "type": "string" }
          }
        },
        "additionalProperties": false
      }
    },
    "chiefOfStaff": {
      "description": "The lead agent's key (this worker's `id`, or one of `agents[].key`). Defaults to the worker's own id. Becomes the generated package's team.leader.",
      "type": "string"
    },
    "rooms": {
      "description": "Optional extension: shared chat rooms between this worker's agents.",
      "type": "array", "maxItems": 30,
      "items": {
        "type": "object",
        "required": ["key", "name", "bulletin", "members", "defaultResponder"],
        "properties": {
          "key": { "type": "string", "maxLength": 64 },
          "name": { "type": "string", "minLength": 1, "maxLength": 100 },
          "bulletin": { "type": "string", "maxLength": 12000 },
          "members": {
            "description": "Agent keys (this worker's `id` and/or `agents[].key`); at least one.",
            "type": "array", "minItems": 1, "maxItems": 50, "items": { "type": "string" }
          },
          "defaultResponder": {
            "oneOf": [
              {
                "type": "object",
                "required": ["kind", "agent"],
                "properties": { "kind": { "const": "agent" }, "agent": { "type": "string", "description": "Must be one of this room's members." } },
                "additionalProperties": false
              },
              {
                "type": "object",
                "required": ["kind"],
                "properties": { "kind": { "enum": ["everyone", "mentions"] } },
                "additionalProperties": false
              }
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "routines": {
      "description": "Optional extension: scheduled automations. Always installs paused — enabledAfterInstall must be false.",
      "type": "array", "maxItems": 50,
      "items": {
        "type": "object",
        "required": ["key", "name", "agent", "prompt", "runOn", "durationMinutes", "enabledAfterInstall", "schedule"],
        "properties": {
          "key": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$", "maxLength": 64 },
          "name": { "type": "string", "minLength": 1, "maxLength": 80 },
          "agent": { "type": "string", "description": "Must be this worker's `id` or one of `agents[].key`." },
          "prompt": { "type": "string", "minLength": 1, "maxLength": 20000 },
          "runOn": { "enum": ["duo", "cloud"] },
          "durationMinutes": { "type": "integer", "minimum": 5, "maximum": 240 },
          "enabledAfterInstall": { "const": false },
          "schedule": {
            "oneOf": [
              {
                "type": "object",
                "required": ["type", "time", "weekdays"],
                "properties": {
                  "type": { "const": "daily" },
                  "time": { "type": "string", "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$" },
                  "weekdays": {
                    "type": "array", "minItems": 1, "maxItems": 7,
                    "items": { "type": "integer", "minimum": 0, "maximum": 6 },
                    "uniqueItems": true
                  }
                },
                "additionalProperties": false
              },
              {
                "type": "object",
                "required": ["type", "at"],
                "properties": { "type": { "const": "once" }, "at": { "type": "integer" } },
                "additionalProperties": false
              }
            ]
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
