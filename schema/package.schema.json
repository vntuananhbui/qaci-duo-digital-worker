{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/vanhaito/qaci-duo-playbooks/main/schema/package.schema.json",
  "title": "QACI Duo package v2",
  "description": "The YAML frontmatter of a generated packages/<id>.md file (what scripts/lib.mjs's workerPackage() writes and validatePackage() checks). This schema documents the hand-written validator in scripts/lib.mjs; that file remains the source of truth and the authoritative CI gate — this is tooling/editor documentation only, and may lag a rule that changed there. `additionalProperties` is left permissive wherever validatePackage() itself does not exhaustively reject unknown keys (only workers/<id>/worker.yaml and SKILL.md frontmatter are closed sets in the real validator). The shape matches QACI Duo's own package v2 (shared/package-format.ts's packageDocumentSchema): a nested `team` object instead of a flat `chiefOfStaff`, plus `connections` and `skills.entries`.",
  "type": "object",
  "required": [
    "format", "version", "id", "release", "name", "tagline", "summary", "category", "author", "license",
    "outcomes", "setupMinutes", "requirements", "agents", "team"
  ],
  "properties": {
    "format": { "const": "qaci-duo.package" },
    "version": { "const": 2 },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "release": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "name": { "type": "string", "minLength": 1, "maxLength": 100 },
    "tagline": { "type": "string", "minLength": 1, "maxLength": 160 },
    "summary": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "category": { "type": "string", "minLength": 1, "maxLength": 80 },
    "author": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 100 },
        "url": { "type": "string", "pattern": "^https://" }
      },
      "additionalProperties": true
    },
    "license": { "type": "string", "minLength": 1, "maxLength": 80 },
    "featured": { "type": "boolean" },
    "tags": { "type": "array", "maxItems": 30, "items": { "type": "string", "maxLength": 80 } },
    "outcomes": {
      "type": "array", "minItems": 1, "maxItems": 12,
      "items": { "type": "string", "minLength": 1, "maxLength": 240 }
    },
    "setupMinutes": { "type": "integer", "minimum": 1, "maximum": 240 },
    "requirements": {
      "type": "object",
      "properties": {
        "apps": {
          "type": "array", "maxItems": 30,
          "items": {
            "type": "object",
            "required": ["slug", "label", "reason"],
            "properties": {
              "slug": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$", "maxLength": 80 },
              "label": { "type": "string", "minLength": 1, "maxLength": 100 },
              "reason": { "type": "string", "minLength": 1, "maxLength": 240 },
              "optional": { "type": "boolean" }
            },
            "additionalProperties": true
          }
        },
        "capabilities": { "type": "array", "maxItems": 20, "items": { "type": "string" } },
        "platforms": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": true
    },
    "agents": {
      "type": "array", "minItems": 1, "maxItems": 50,
      "items": {
        "type": "object",
        "required": ["key", "name", "title", "description", "appearance"],
        "properties": {
          "key": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$", "maxLength": 64 },
          "name": { "type": "string", "minLength": 1, "maxLength": 100 },
          "title": { "type": "string", "maxLength": 200 },
          "description": { "type": "string", "maxLength": 4000 },
          "appearance": {
            "type": "object",
            "required": ["color"],
            "properties": {
              "color": {
                "enum": ["green", "blue", "red", "orange", "purple", "cyan", "pink", "yellow", "teal", "coral"]
              }
            },
            "additionalProperties": true
          },
          "soul": { "type": "string", "maxLength": 24000, "description": "This agent's standing system prompt." },
          "playbooks": { "type": "array", "items": { "type": "string" } },
          "skills": { "type": "array", "items": { "type": "string" }, "description": "Names from skills.entries[] this agent carries." },
          "connections": { "type": "array", "items": { "type": "string" }, "description": "Keys from the top-level connections[] this agent is given. Never defaults to all — omitted means none." }
        },
        "additionalProperties": true
      }
    },
    "team": {
      "type": "object",
      "required": ["name"],
      "description": "Required whenever the package has agents (always true for a generated package).",
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 60 },
        "leader": { "type": "string", "description": "An agent key; the Chief of Staff." },
        "brief": { "type": "string", "maxLength": 24000 }
      },
      "additionalProperties": true
    },
    "connections": {
      "description": "Up to 20 declared MCP slots. Never carries a secret value — only the address and the header value names an installer supplies.",
      "type": "array", "maxItems": 20,
      "items": {
        "type": "object",
        "required": ["key", "label", "reason", "mcp"],
        "properties": {
          "key": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$", "maxLength": 64 },
          "label": { "type": "string", "minLength": 1, "maxLength": 100 },
          "reason": { "type": "string", "minLength": 1, "maxLength": 240 },
          "mcp": {
            "type": "object",
            "required": ["transport", "url", "valueNames"],
            "properties": {
              "transport": { "enum": ["http", "sse"] },
              "url": { "type": "string", "pattern": "^https://\\S+$" },
              "valueNames": { "type": "array", "maxItems": 32, "items": { "type": "string" }, "uniqueItems": true }
            },
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      }
    },
    "examples": {
      "description": "Up to 12 suggested questions, shown on the worker's page.",
      "type": "array", "maxItems": 12,
      "items": {
        "type": "object",
        "required": ["title", "input", "output"],
        "properties": {
          "title": { "type": "string", "minLength": 1, "maxLength": 120 },
          "input": { "type": "string", "minLength": 1, "maxLength": 4000 },
          "output": { "type": "string", "minLength": 1, "maxLength": 8000 }
        },
        "additionalProperties": true
      }
    },
    "rooms": {
      "type": "array", "maxItems": 30,
      "items": {
        "type": "object",
        "required": ["key", "name", "members", "bulletin", "defaultResponder"],
        "properties": {
          "key": { "type": "string", "maxLength": 64 },
          "name": { "type": "string", "minLength": 1, "maxLength": 100 },
          "bulletin": { "type": "string", "maxLength": 12000 },
          "members": { "type": "array", "minItems": 1, "maxItems": 50, "items": { "type": "string" } },
          "defaultResponder": {
            "oneOf": [
              {
                "type": "object",
                "required": ["kind", "agent"],
                "properties": { "kind": { "const": "agent" }, "agent": { "type": "string" } },
                "additionalProperties": true
              },
              {
                "type": "object",
                "required": ["kind"],
                "properties": { "kind": { "enum": ["everyone", "mentions"] } },
                "additionalProperties": true
              }
            ]
          }
        },
        "additionalProperties": true
      }
    },
    "routines": {
      "type": "array", "maxItems": 50,
      "items": {
        "type": "object",
        "required": ["key", "name", "agent", "prompt", "runOn", "schedule", "durationMinutes", "enabledAfterInstall"],
        "properties": {
          "key": { "type": "string", "maxLength": 64 },
          "name": { "type": "string", "minLength": 1, "maxLength": 80 },
          "agent": { "type": "string" },
          "prompt": { "type": "string", "minLength": 1, "maxLength": 20000 },
          "runOn": { "enum": ["duo", "cloud"] },
          "durationMinutes": { "type": "integer", "minimum": 5, "maximum": 240 },
          "enabledAfterInstall": {
            "const": false,
            "description": "A routine must always install switched off; its owner turns it on after reviewing it."
          },
          "schedule": {
            "oneOf": [
              {
                "type": "object",
                "required": ["type", "time", "weekdays"],
                "properties": {
                  "type": { "const": "daily" },
                  "time": { "type": "string", "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$" },
                  "weekdays": {
                    "type": "array", "minItems": 1, "maxItems": 7,
                    "items": { "type": "integer", "minimum": 0, "maximum": 6 },
                    "uniqueItems": true
                  }
                },
                "additionalProperties": true
              },
              {
                "type": "object",
                "required": ["type", "at"],
                "properties": { "type": { "const": "once" }, "at": { "type": "integer" } },
                "additionalProperties": true
              }
            ]
          }
        },
        "additionalProperties": true
      }
    },
    "playbooks": {
      "description": "A package needs at least one playbook or skill (here or in `skills.entries`) across its agents.",
      "type": "array", "minItems": 1, "maxItems": 80,
      "items": {
        "type": "object",
        "required": ["key", "name", "summary", "triggers", "instructions"],
        "properties": {
          "key": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$", "maxLength": 64 },
          "name": { "type": "string", "minLength": 1, "maxLength": 100 },
          "summary": { "type": "string", "minLength": 1, "maxLength": 300 },
          "triggers": {
            "type": "array", "minItems": 1, "maxItems": 30,
            "items": { "type": "string", "minLength": 1, "maxLength": 100 }
          },
          "instructions": { "type": "string", "minLength": 1, "maxLength": 24000 }
        },
        "additionalProperties": true
      }
    },
    "skills": {
      "description": "Whole embedded skills, each a real SKILL.md file, as opposed to the lighter `playbooks[]` shape above.",
      "type": "object",
      "required": ["version", "entries"],
      "properties": {
        "version": { "const": 1 },
        "entries": {
          "type": "array", "minItems": 1, "maxItems": 60,
          "items": {
            "type": "object",
            "required": ["name", "description", "instructions"],
            "properties": {
              "name": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 64 },
              "description": { "type": "string", "minLength": 1, "maxLength": 1024 },
              "source": { "type": "string", "maxLength": 2000 },
              "license": { "type": "string", "maxLength": 200 },
              "compatibility": { "type": "string", "maxLength": 200 },
              "instructions": {
                "type": "string", "maxLength": 262144,
                "pattern": "^---\\r?\\n",
                "description": "The whole SKILL.md file, verbatim; its own frontmatter `description` must match the sibling field above."
              }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
